local triggered = false
local connection

local function Trigger()
	if triggered or not deathActive then
		return
	end
	
	local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 2)
	local MainUI = PlayerGui and PlayerGui:FindFirstChild("MainUI")
	local Death = MainUI and MainUI:FindFirstChild("Death")
	
	if Death then
		repeat task.wait(0.1) until Death.Visible or not deathActive
	else
		task.wait(1.5)
	end
	
	if not deathActive or triggered then return end
	triggered = true
	
	if connection then
		connection:Disconnect()
		connection = nil
	end
	RunScript()
end

if Camera then
	for _, obj in ipairs(Camera:GetDescendants()) do
		if obj:IsA("Model") and obj.Name == "DeathBackgroundBlue" then
			Trigger()
			break
		end
	end
end

if not triggered and Camera then
	connection = Camera.DescendantAdded:Connect(function(obj)
		if obj:IsA("Model") and obj.Name == "DeathBackgroundBlue" then
			Trigger()
		end
	end)
end

