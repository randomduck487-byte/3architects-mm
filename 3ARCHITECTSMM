	local function TypeText(label, text)
		task.spawn(function()
			if not label or not label.Parent then return end
			label.Visible = true
			label.TextTransparency = 0
			label.Text = ""

			local words = {}
			for word in text:gmatch("%S+") do table.insert(words, word) end
			local lines, line = {}, {}
			for _, word in ipairs(words) do
				table.insert(line, word)
				if #line == 6 then table.insert(lines, table.concat(line, " ")); line = {} end
			end
			if #line > 0 then table.insert(lines, table.concat(line, " ")) end
			local formattedText = table.concat(lines, "\n")

			for i = 1, #formattedText do
				if not label or not label.Parent then return end
				label.Text = formattedText:sub(1, i)
				task.wait(0.01)
			end

			task.wait(2.5)

			if label and label.Parent then
				local tw = TweenService:Create(label, TweenInfo.new(0.5, Enum.EasingStyle.Linear), {TextTransparency = 1})
